#!/bin/sh
printf '%s\n' "$*" | tr '\n' ' ' >> "$SAM_STACK_WORK/../herdr.log"
echo >> "$SAM_STACK_WORK/../herdr.log"
case "$1 $2" in
  "tab create"|"worktree create") echo '{"result": {"root_pane": {"pane_id": "w1:p9"}}}' ;;
  "agent get"|"agent wait") echo "{\"result\": {\"agent\": {\"name\": \"$3\", \"agent_status\": \"done\"}}}" ;;
  *) echo '{"result": {}}' ;;
esac
